{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "oferta-tecnologica": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "utn",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/oferta-tecnologica",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              "src/assets",
              { "glob": "index.html", "input": ".", "output": "content" },
              { "glob": "vinculacion.html", "input": ".", "output": "content" },
              { "glob": "**/*.html", "input": "pagina-lea", "output": "content/pagina-lea" },
              { "glob": "**/*.html", "input": "secretaria-extension-universitaria-main", "output": "content/secretaria-extension-universitaria-main" },
              { "glob": "**/*.html", "input": "vinculacion", "output": "content/vinculacion" },
              { "glob": "styles.css", "input": "pagina-lea", "output": "content/pagina-lea" },
              { "glob": "styles.css", "input": "secretaria-extension-universitaria-main", "output": "content/secretaria-extension-universitaria-main" },
              { "glob": "styles.css", "input": "vinculacion", "output": "content/vinculacion" },
              { "glob": "**/*", "input": "pagina-lea/assets", "output": "pagina-lea/assets" },
              { "glob": "**/*", "input": "secretaria-extension-universitaria-main/assets", "output": "secretaria-extension-universitaria-main/assets" },
              { "glob": "**/*", "input": "vinculacion/assets", "output": "vinculacion/assets" },
              { "glob": "**/*", "input": "pagina-lea/assets", "output": "content/pagina-lea/assets" },
              { "glob": "**/*", "input": "secretaria-extension-universitaria-main/assets", "output": "content/secretaria-extension-universitaria-main/assets" },
              { "glob": "**/*", "input": "vinculacion/assets", "output": "content/vinculacion/assets" }
            ],
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": { "budgets": [{ "type": "initial", "maximumWarning": "2mb", "maximumError": "5mb" }], "outputHashing": "all" },
            "development": { "optimization": false, "extractLicenses": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": { "production": { "buildTarget": "oferta-tecnologica:build:production" }, "development": { "buildTarget": "oferta-tecnologica:build:development" } },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}